    conditionBonusToAllEquipment: 8
    spawnsArray: {fileID: 0}
    spawnPosition: {x: 4, y: 0, z: 2}
    resultLog: Donuts acquired. Condition mysteriously improves.
  choiceB:
    label: 'Suggest fruit instead

      Crew mutiny averted (barely)'
    cashCost: 0
    conditionBonusToAllEquipment: 0
    spawnsArray: {fileID: 0}
    spawnPosition: {x: 4, y: 0, z: 2}
    resultLog: You suggest apples. Jordan files this under "leadership moments".
