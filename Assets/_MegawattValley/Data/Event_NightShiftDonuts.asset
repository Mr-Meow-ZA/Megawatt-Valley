  title: Night Shift Donuts
  body: Jordan found a bakery that sells "inverter-glazed" donuts at 2am. The crew is watching you.
  triggerAfterSeconds: 150
  choiceA:
    label: 'Buy the box

      -${cost}, +{condition} morale wipe'
