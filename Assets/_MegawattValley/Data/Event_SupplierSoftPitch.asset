MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f57202d9ee0ac8c47be4aefa6709e6fd, type: 3}
  m_Name: Event_SupplierSoftPitch
  m_EditorClassIdentifier: Assembly-CSharp::MegawattValley.Data.DecisionEventDefinition
  title: Supplier Soft Pitch
  body: A salesman offers "premium" panels that look suspiciously like last year's stock with a fresh sticker. He is already unloading them onto your access road.
  triggerAfterSeconds: 90
  choiceA:
    label: 'Buy the bargain lot

      -${cost} for {mw} MW'
    cashCost: 120
    conditionBonusToAllEquipment: 0
    spawnsArray: {fileID: 11400000, guid: d6a97514f5af6d643890794c89bdc7e4, type: 2}
    spawnPosition: {x: 4, y: 0, z: 2}
    resultLog: You bought the sticker-premium panels. The spreadsheet is optimistic.
  choiceB:
    label: 'Politely decline

      Free panel wipe, +{condition} condition'
    cashCost: 0
    conditionBonusToAllEquipment: 8
    spawnsArray: {fileID: 0}
    spawnPosition: {x: 4, y: 0, z: 2}
    resultLog: You decline. The technician wipes down the arrays out of sheer relief.
