MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f57202d9ee0ac8c47be4aefa6709e6fd, type: 3}
  m_Name: Event_GridCurtailmentMemo
  m_EditorClassIdentifier: Assembly-CSharp::MegawattValley.Data.DecisionEventDefinition
  title: Grid Curtailment Memo
  body: The utility asks you to "voluntarily" dial back export this afternoon. Their emoji use is aggressive.
  triggerAfterSeconds: 90
  choiceA:
    label: 'Comply cheerfully

      Free +{condition} maintenance window'
    cashCost: 0
    conditionBonusToAllEquipment: 12
    spawnsArray: {fileID: 0}
    spawnPosition: {x: 4, y: 0, z: 2}
    resultLog: You curtail. The utility sends a thumbs-up sticker.
  choiceB:
    label: 'Negotiate a tiny fee

      +${cost} cash (they pay you)'
    cashCost: -40
    conditionBonusToAllEquipment: 0
    spawnsArray: {fileID: 0}
    spawnPosition: {x: 4, y: 0, z: 2}
    resultLog: You extract a courtesy payment. The spreadsheet smiles.
