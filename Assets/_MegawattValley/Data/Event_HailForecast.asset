  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f57202d9ee0ac8c47be4aefa6709e6fd, type: 3}
  m_Name: Event_HailForecast
  m_EditorClassIdentifier: Assembly-CSharp::MegawattValley.Data.DecisionEventDefinition
  title: Severe Hail Forecast
  body: Met office just upgraded the afternoon cells to "golf-ball adjacent". You can tarp the tables now, or keep exporting and hope the insurance forms are funny.
  triggerAfterSeconds: 0
  choiceA:
    label: 'Deploy hail covers

      -${cost}, +{condition} protection'
    cashCost: 180
    conditionBonusToAllEquipment: 20
    conditionPenaltyToAllEquipment: 0
    forceFaultOnAllEquipment: 0
    spawnsArray: {fileID: 0}
    spawnPosition: {x: 4, y: 0, z: 2}
    resultLog: Covers deployed. Export dips while the crew cheers the thunder.
  choiceB:
    label: "Keep exporting\nNo cost \u2014 storm damage likely"
    cashCost: 0
    conditionBonusToAllEquipment: 0
    conditionPenaltyToAllEquipment: 35
    forceFaultOnAllEquipment: 1
    spawnsArray: {fileID: 0}
    spawnPosition: {x: 4, y: 0, z: 2}
    resultLog: You rode it out. Several tables now sound like broken biscuits.
