  title: Bird Strike Briefing
  body: A flock of very confident starlings has been using your premium arrays as a landing strip. Ops wants a response.
  triggerAfterSeconds: 55
  choiceA:
    label: 'Hire a polite falconer

      -${cost}'
    cashCost: 90
    conditionBonusToAllEquipment: 0
    spawnsArray: {fileID: 0}
    spawnPosition: {x: 4, y: 0, z: 2}
    resultLog: A falcon named Kevin now patrols. The starlings file a complaint.
  choiceB:
    label: 'Install shiny deterrents

      +{condition} site-wide wipe'
    cashCost: 0
    conditionBonusToAllEquipment: 10
    spawnsArray: {fileID: 0}
    spawnPosition: {x: 4, y: 0, z: 2}
    resultLog: You hang CDs on string. It is ugly. It works. Kevin is unemployed.
