{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/session-start.ps1",
        "timeout": 90
      }
    ],
    "stop": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/session-stop.ps1",
        "timeout": 30,
        "loop_limit": 1
      }
    ],
    "sessionEnd": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/session-end.ps1",
        "timeout": 60
      }
    ]
  }
}
