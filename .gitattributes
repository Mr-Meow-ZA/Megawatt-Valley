# Unity YAML / text stay as Git text.
# Unity always writes these with LF, so pin eol=lf to stop Windows checkouts
# from rewriting every asset to CRLF and creating whitespace-only churn.
*.cs diff=csharp text
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.compute text eol=lf
*.json text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.mat text eol=lf
*.inputactions text eol=lf
*.uss text eol=lf
*.uxml text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.wlt text eol=lf

# Binary assets via Git LFS
